# Copy to .env and fill in. Never commit .env to GitHub.

# --- Mailbox (IMAP) ---
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=your_mailbox@gmail.com
# Gmail: enable 2-Step Verification, then create an App Password
EMAIL_PASSWORD=your_16_char_app_password
QUARANTINE_FOLDER=PhishGuard-Quarantine

# --- Alerts (SMTP) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
ALERT_RECIPIENT=security-team@example.com

# --- VirusTotal API v3 (free key: https://www.virustotal.com) ---
VT_API_KEY=your_virustotal_api_key
# Free tier allows 4 requests/minute
VT_DELAY_SECONDS=16

# --- Decision engine ---
URL_WEIGHT=0.5
CONTENT_WEIGHT=0.5
PHISHING_THRESHOLD=0.70
SUSPICIOUS_THRESHOLD=0.40
STRONG_CONTENT_THRESHOLD=0.90

# --- Scheduler ---
POLL_INTERVAL_SECONDS=120
